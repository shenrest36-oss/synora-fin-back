generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id               String   @id @default(uuid()) @db.Char(36)
  code             String   @unique @db.VarChar(20)
  name             String   @db.VarChar(255)
  address          String?  @db.Text
  phone            String?  @db.VarChar(30)
  email            String?  @db.VarChar(150)
  taxRegistration  String?  @db.VarChar(50)
  currencyCode     String   @default("USD") @db.VarChar(10)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?  @db.Char(36)
  updatedBy        String?  @db.Char(36)

  branches         Branch[]
  financialYears   FinancialYear[]
  users            User[]
  systemConfigs    SystemConfiguration[]
  accountCategories AccountCategory[]
  accountSubcategories AccountSubcategory[]
  accountTypes     AccountType[]
  chartOfAccounts  ChartOfAccount[]
  departments      Department[]
  journalEntries   JournalEntry[]
  ledgerPostings   LedgerPosting[]
  debtors          Debtor[]
  creditors        Creditor[]
  debtorInvoices   DebtorInvoice[]
  creditorInvoices  CreditorInvoice[]
  debtorCreditNotes DebtorCreditNote[]
  creditorNotes    CreditorNote[]
  receipts         Receipt[]
  supplierPayments SupplierPayment[]
  allocations     Allocation[]
  bankAccounts     BankAccount[]
  bankTransactions BankTransaction[]
  paymentVouchers  PaymentVoucher[]
  cheques          Cheque[]
  bankReconciliations BankReconciliation[]
  pmsConnections   PmsConnection[]
  pmsAccountMappings PmsAccountMapping[]
  pmsDepartmentMappings PmsDepartmentMapping[]
  pmsImportBatches PmsImportBatch[]
  pmsImportTransactions PmsImportTransaction[]
  pmsReconciliations PmsReconciliation[]

  @@map("companies")
}

model Branch {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String   @db.Char(36)
  code        String   @db.VarChar(20)
  name        String   @db.VarChar(255)
  address     String?  @db.Text
  phone       String?  @db.VarChar(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  @db.Char(36)

  company     Company  @relation(fields: [companyId], references: [id])
  users       User[]
  chartOfAccounts ChartOfAccount[]
  journalEntries JournalEntry[]
  ledgerPostings LedgerPosting[]
  debtors     Debtor[]
  creditors   Creditor[]
  bankAccounts BankAccount[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  companyId    String    @db.Char(36)
  branchId     String?   @db.Char(36)
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @db.VarChar(255)
  firstName    String    @db.VarChar(100)
  lastName     String    @db.VarChar(100)
  phone        String?   @db.VarChar(30)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?   @db.Char(36)
  updatedBy    String?   @db.Char(36)

  company      Company   @relation(fields: [companyId], references: [id])
  branch       Branch?   @relation(fields: [branchId], references: [id])
  userRoles    UserRole[]
  auditLogs    AuditLog[]

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  roleId    String   @db.Char(36)
  createdAt DateTime @default(now())
  createdBy String?  @db.Char(36)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Char(36)
  roleId       String   @db.Char(36)
  permissionId String   @db.Char(36)
  createdAt    DateTime @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model FinancialYear {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String   @db.Char(36)
  yearCode    String   @db.VarChar(20)
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  status      String   @default("OPEN") @db.VarChar(20)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  @db.Char(36)
  closedAt    DateTime?
  closedBy    String?  @db.Char(36)

  company           Company          @relation(fields: [companyId], references: [id])
  accountingPeriods AccountingPeriod[]
  journalEntries    JournalEntry[]
  ledgerPostings    LedgerPosting[]

  @@unique([companyId, yearCode])
  @@index([companyId])
  @@map("financial_years")
}

model AccountingPeriod {
  id              String   @id @default(uuid()) @db.Char(36)
  financialYearId String   @db.Char(36)
  periodNumber    Int
  name            String   @db.VarChar(50)
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  status          String   @default("OPEN") @db.VarChar(20)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?  @db.Char(36)
  closedAt        DateTime?
  closedBy        String?  @db.Char(36)

  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  journalEntries  JournalEntry[]
  ledgerPostings  LedgerPosting[]

  @@unique([financialYearId, periodNumber])
  @@index([financialYearId])
  @@map("accounting_periods")
}

model AccountCategory {
  id                String   @id @default(uuid()) @db.Char(36)
  companyId         String   @db.Char(36)
  categoryCode      String   @db.VarChar(20)
  categoryName      String   @db.VarChar(100)
  accountNumberStart Int     @db.Int
  accountNumberEnd   Int     @db.Int
  description       String?  @db.Text
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company           Company            @relation(fields: [companyId], references: [id])
  subcategories     AccountSubcategory[]
  chartOfAccounts   ChartOfAccount[]

  @@unique([companyId, categoryCode])
  @@index([companyId])
  @@map("account_categories")
}

model AccountSubcategory {
  id              String   @id @default(uuid()) @db.Char(36)
  companyId       String   @db.Char(36)
  categoryId      String   @db.Char(36)
  subcategoryCode String   @db.VarChar(20)
  subcategoryName String   @db.VarChar(120)
  description     String?  @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  category        AccountCategory  @relation(fields: [categoryId], references: [id])
  chartOfAccounts ChartOfAccount[]

  @@unique([categoryId, subcategoryCode])
  @@index([categoryId])
  @@map("account_subcategories")
}

model AccountType {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String   @db.Char(36)
  typeCode    String   @db.VarChar(20)
  typeName    String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id])
  chartOfAccounts ChartOfAccount[]

  @@unique([companyId, typeCode])
  @@index([companyId])
  @@map("account_types")
}

model ChartOfAccount {
  id             String   @id @default(uuid()) @db.Char(36)
  companyId      String   @db.Char(36)
  branchId       String?  @db.Char(36)
  categoryId     String   @db.Char(36)
  subcategoryId  String?  @db.Char(36)
  accountTypeId  String?  @db.Char(36)
  accountCode    String   @db.VarChar(50)
  accountName    String   @db.VarChar(200)
  description    String?  @db.Text
  isActive       Boolean  @default(true)
  isSystemAccount Boolean @default(false)
  createdBy      String?  @db.Char(36)
  updatedBy      String?  @db.Char(36)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company           @relation(fields: [companyId], references: [id])
  branch         Branch?           @relation(fields: [branchId], references: [id])
  category       AccountCategory   @relation(fields: [categoryId], references: [id])
  subcategory    AccountSubcategory? @relation(fields: [subcategoryId], references: [id])
  accountType    AccountType?      @relation(fields: [accountTypeId], references: [id])
  departments    AccountDepartment[]
  journalEntryLines JournalEntryLine[]
  ledgerPostings LedgerPosting[]
  debtors        Debtor[]
  creditors      Creditor[]
  bankAccounts   BankAccount[] @relation("BankAccountGL")
  pmsAccountMappings PmsAccountMapping[]

  @@unique([companyId, accountCode])
  @@index([companyId])
  @@index([categoryId])
  @@index([accountTypeId])
  @@map("chart_of_accounts")
}

model Department {
  id              String   @id @default(uuid()) @db.Char(36)
  companyId       String   @db.Char(36)
  departmentCode  String   @db.VarChar(20)
  departmentName  String   @db.VarChar(120)
  description     String?  @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  subDepartments  SubDepartment[]
  accountMappings AccountDepartment[]
  journalEntryLines JournalEntryLine[]
  ledgerPostings LedgerPosting[]
  pmsAccountMappings PmsAccountMapping[]
  pmsDepartmentMappings PmsDepartmentMapping[]

  @@unique([companyId, departmentCode])
  @@index([companyId])
  @@map("departments")
}

model SubDepartment {
  id                String   @id @default(uuid()) @db.Char(36)
  departmentId      String   @db.Char(36)
  subDepartmentCode String   @db.VarChar(20)
  subDepartmentName String   @db.VarChar(120)
  description       String?  @db.Text
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  department        Department         @relation(fields: [departmentId], references: [id])
  accountMappings   AccountDepartment[]
  journalEntryLines JournalEntryLine[]
  ledgerPostings    LedgerPosting[]

  @@unique([departmentId, subDepartmentCode])
  @@index([departmentId])
  @@map("sub_departments")
}

model AccountDepartment {
  id             String   @id @default(uuid()) @db.Char(36)
  accountId      String   @db.Char(36)
  departmentId   String   @db.Char(36)
  subDepartmentId String?  @db.Char(36)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account        ChartOfAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  department     Department      @relation(fields: [departmentId], references: [id])
  subDepartment  SubDepartment?  @relation(fields: [subDepartmentId], references: [id])

  @@unique([accountId, departmentId, subDepartmentId])
  @@index([accountId])
  @@index([departmentId])
  @@map("account_departments")
}

model JournalEntry {
  id                 String    @id @default(uuid()) @db.Char(36)
  companyId          String    @db.Char(36)
  branchId           String?   @db.Char(36)
  journalNumber      String    @db.VarChar(50)
  referenceNumber    String?   @db.VarChar(80)
  journalDate        DateTime  @db.Date
  financialYearId    String?   @db.Char(36)
  accountingPeriodId String?   @db.Char(36)
  description        String?   @db.Text
  status             String    @default("DRAFT") @db.VarChar(30)
  totalDebit         Decimal   @default("0.00") @db.Decimal(18, 2)
  totalCredit        Decimal   @default("0.00") @db.Decimal(18, 2)
  sourceType         String?   @db.VarChar(50)
  sourceReferenceId  String?   @db.VarChar(100)
  createdBy          String?   @db.Char(36)
  submittedBy        String?   @db.Char(36)
  approvedBy         String?   @db.Char(36)
  postedBy           String?   @db.Char(36)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  submittedAt        DateTime?
  approvedAt         DateTime?
  postedAt           DateTime?
  reversalOfJournalId String?  @db.Char(36)

  company          Company          @relation(fields: [companyId], references: [id])
  branch           Branch?          @relation(fields: [branchId], references: [id])
  financialYear    FinancialYear?   @relation(fields: [financialYearId], references: [id])
  accountingPeriod AccountingPeriod? @relation(fields: [accountingPeriodId], references: [id])
  lines            JournalEntryLine[]
  ledgerPostings   LedgerPosting[]
  reversalOf       JournalEntry?    @relation("JournalEntryReversal", fields: [reversalOfJournalId], references: [id])
  reversals        JournalEntry[]   @relation("JournalEntryReversal")

  @@unique([companyId, journalNumber])
  @@index([companyId])
  @@index([journalDate])
  @@index([status])
  @@index([referenceNumber])
  @@map("journal_entries")
}

model JournalEntryLine {
  id               String    @id @default(uuid()) @db.Char(36)
  journalEntryId   String    @db.Char(36)
  lineNumber       Int
  accountId        String    @db.Char(36)
  departmentId     String?   @db.Char(36)
  subDepartmentId  String?   @db.Char(36)
  description      String?   @db.Text
  debitAmount      Decimal   @default("0.00") @db.Decimal(18, 2)
  creditAmount     Decimal   @default("0.00") @db.Decimal(18, 2)
  currencyCode     String    @default("USD") @db.VarChar(10)
  exchangeRate     Decimal?  @db.Decimal(18, 6)
  baseDebitAmount  Decimal   @default("0.00") @db.Decimal(18, 2)
  baseCreditAmount Decimal   @default("0.00") @db.Decimal(18, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  journalEntry    JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account         ChartOfAccount  @relation(fields: [accountId], references: [id])
  department     Department?     @relation(fields: [departmentId], references: [id])
  subDepartment  SubDepartment?  @relation(fields: [subDepartmentId], references: [id])
  ledgerPostings  LedgerPosting[]

  @@unique([journalEntryId, lineNumber])
  @@index([journalEntryId])
  @@index([accountId])
  @@index([departmentId])
  @@map("journal_entry_lines")
}

model LedgerPosting {
  id                 String    @id @default(uuid()) @db.Char(36)
  companyId          String    @db.Char(36)
  branchId           String?   @db.Char(36)
  journalEntryId     String    @db.Char(36)
  journalEntryLineId String    @db.Char(36)
  accountId          String    @db.Char(36)
  accountingPeriodId String?   @db.Char(36)
  financialYearId    String?   @db.Char(36)
  postingDate        DateTime  @db.Date
  referenceNumber    String    @db.VarChar(80)
  description        String?   @db.Text
  debitAmount        Decimal   @default("0.00") @db.Decimal(18, 2)
  creditAmount       Decimal   @default("0.00") @db.Decimal(18, 2)
  currencyCode       String    @default("USD") @db.VarChar(10)
  exchangeRate       Decimal?  @db.Decimal(18, 6)
  baseDebitAmount    Decimal   @default("0.00") @db.Decimal(18, 2)
  baseCreditAmount   Decimal   @default("0.00") @db.Decimal(18, 2)
  departmentId       String?   @db.Char(36)
  subDepartmentId    String?   @db.Char(36)
  createdAt          DateTime  @default(now())

  company          Company          @relation(fields: [companyId], references: [id])
  branch           Branch?          @relation(fields: [branchId], references: [id])
  journalEntry     JournalEntry     @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  journalEntryLine JournalEntryLine @relation(fields: [journalEntryLineId], references: [id], onDelete: Cascade)
  account          ChartOfAccount   @relation(fields: [accountId], references: [id])
  accountingPeriod AccountingPeriod? @relation(fields: [accountingPeriodId], references: [id])
  financialYear    FinancialYear?   @relation(fields: [financialYearId], references: [id])
  department       Department?     @relation(fields: [departmentId], references: [id])
  subDepartment    SubDepartment?  @relation(fields: [subDepartmentId], references: [id])

  @@unique([journalEntryId, journalEntryLineId])
  @@index([companyId, postingDate])
  @@index([accountId, postingDate])
  @@index([financialYearId])
  @@index([accountingPeriodId])
  @@index([referenceNumber])
  @@map("ledger_postings")
}

model Debtor {
  id                    String   @id @default(uuid()) @db.Char(36)
  companyId             String   @db.Char(36)
  branchId              String?  @db.Char(36)
  debtorCode            String   @db.VarChar(50)
  debtorName            String   @db.VarChar(200)
  debtorType            String   @db.VarChar(50)
  contactPerson         String?  @db.VarChar(150)
  email                 String?  @db.VarChar(150)
  phone                 String?  @db.VarChar(30)
  address               String?  @db.Text
  taxRegistrationNumber String?  @db.VarChar(100)
  creditLimit           Decimal  @default("0.00") @db.Decimal(18, 2)
  creditPeriodDays      Int      @default(30)
  currencyCode          String   @default("USD") @db.VarChar(10)
  accountId             String?  @db.Char(36)
  isActive              Boolean  @default(true)
  createdBy             String?  @db.Char(36)
  updatedBy             String?  @db.Char(36)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company             Company            @relation(fields: [companyId], references: [id])
  branch              Branch?            @relation(fields: [branchId], references: [id])
  account             ChartOfAccount?    @relation(fields: [accountId], references: [id])
  invoices            DebtorInvoice[]
  creditNotes         DebtorCreditNote[]
  receipts            Receipt[]

  @@unique([companyId, debtorCode])
  @@index([companyId])
  @@index([branchId])
  @@map("debtors")
}

model Creditor {
  id                    String   @id @default(uuid()) @db.Char(36)
  companyId             String   @db.Char(36)
  branchId              String?  @db.Char(36)
  creditorCode          String   @db.VarChar(50)
  creditorName          String   @db.VarChar(200)
  creditorType          String   @db.VarChar(50)
  contactPerson         String?  @db.VarChar(150)
  email                 String?  @db.VarChar(150)
  phone                 String?  @db.VarChar(30)
  address               String?  @db.Text
  taxRegistrationNumber String?  @db.VarChar(100)
  creditLimit           Decimal  @default("0.00") @db.Decimal(18, 2)
  creditPeriodDays      Int      @default(30)
  currencyCode          String   @default("USD") @db.VarChar(10)
  accountId             String?  @db.Char(36)
  isActive              Boolean  @default(true)
  createdBy             String?  @db.Char(36)
  updatedBy             String?  @db.Char(36)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company             Company             @relation(fields: [companyId], references: [id])
  branch              Branch?             @relation(fields: [branchId], references: [id])
  account             ChartOfAccount?     @relation(fields: [accountId], references: [id])
  invoices            CreditorInvoice[]
  adjustmentNotes     CreditorNote[]
  payments            SupplierPayment[]
  paymentVouchers     PaymentVoucher[]

  @@unique([companyId, creditorCode])
  @@index([companyId])
  @@index([branchId])
  @@map("creditors")
}

model DebtorInvoice {
  id                String   @id @default(uuid()) @db.Char(36)
  companyId         String   @db.Char(36)
  debtorId          String   @db.Char(36)
  invoiceNumber     String   @db.VarChar(80)
  invoiceDate       DateTime @db.Date
  dueDate           DateTime @db.Date
  referenceNumber   String?  @db.VarChar(80)
  description       String?  @db.Text
  subtotal          Decimal  @default("0.00") @db.Decimal(18, 2)
  taxAmount         Decimal  @default("0.00") @db.Decimal(18, 2)
  totalAmount       Decimal  @default("0.00") @db.Decimal(18, 2)
  allocatedAmount   Decimal  @default("0.00") @db.Decimal(18, 2)
  outstandingAmount Decimal  @default("0.00") @db.Decimal(18, 2)
  currencyCode      String   @default("USD") @db.VarChar(10)
  status            String   @default("DRAFT") @db.VarChar(30)
  journalEntryId    String?  @db.Char(36)
  createdBy         String?  @db.Char(36)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company           Company           @relation(fields: [companyId], references: [id])
  debtor             Debtor            @relation(fields: [debtorId], references: [id])
  creditNotes       DebtorCreditNote[]

  @@unique([companyId, invoiceNumber])
  @@index([debtorId])
  @@index([companyId, status])
  @@map("debtor_invoices")
}

model CreditorInvoice {
  id                String   @id @default(uuid()) @db.Char(36)
  companyId         String   @db.Char(36)
  creditorId        String   @db.Char(36)
  invoiceNumber     String   @db.VarChar(80)
  invoiceDate       DateTime @db.Date
  dueDate           DateTime @db.Date
  referenceNumber   String?  @db.VarChar(80)
  description       String?  @db.Text
  subtotal          Decimal  @default("0.00") @db.Decimal(18, 2)
  taxAmount         Decimal  @default("0.00") @db.Decimal(18, 2)
  totalAmount       Decimal  @default("0.00") @db.Decimal(18, 2)
  allocatedAmount   Decimal  @default("0.00") @db.Decimal(18, 2)
  outstandingAmount Decimal  @default("0.00") @db.Decimal(18, 2)
  currencyCode      String   @default("USD") @db.VarChar(10)
  status            String   @default("DRAFT") @db.VarChar(30)
  journalEntryId    String?  @db.Char(36)
  createdBy         String?  @db.Char(36)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company           Company           @relation(fields: [companyId], references: [id])
  creditor          Creditor          @relation(fields: [creditorId], references: [id])
  adjustments       CreditorNote[]

  @@unique([companyId, invoiceNumber])
  @@index([creditorId])
  @@index([companyId, status])
  @@map("creditor_invoices")
}

model DebtorCreditNote {
  id                String   @id @default(uuid()) @db.Char(36)
  companyId         String   @db.Char(36)
  debtorId          String   @db.Char(36)
  invoiceId         String?  @db.Char(36)
  noteNumber        String   @db.VarChar(80)
  noteDate          DateTime @db.Date
  reason            String?  @db.VarChar(200)
  subtotal          Decimal  @default("0.00") @db.Decimal(18, 2)
  taxAmount         Decimal  @default("0.00") @db.Decimal(18, 2)
  totalAmount       Decimal  @default("0.00") @db.Decimal(18, 2)
  currencyCode      String   @default("USD") @db.VarChar(10)
  status            String   @default("DRAFT") @db.VarChar(30)
  journalEntryId    String?  @db.Char(36)
  createdBy         String?  @db.Char(36)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company           Company          @relation(fields: [companyId], references: [id])
  debtor            Debtor           @relation(fields: [debtorId], references: [id])
  invoice           DebtorInvoice?   @relation(fields: [invoiceId], references: [id])

  @@unique([companyId, noteNumber])
  @@index([debtorId])
  @@map("debtor_credit_notes")
}

model CreditorNote {
